# Copy to .env (or set in your hosting provider)

# Required: Postgres connection string.
# Local dev with `docker compose up -d`:
#   postgresql://woyou:woyou@localhost:5444/woyou?schema=public
# Production (Neon free tier — see DEPLOY.md):
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Required in production: 32+ char random string.
SESSION_PASSWORD=change-me-to-a-32+character-random-secret

# One-click role switcher. Set to "false" in real production.
DEMO_MODE=true

# Stripe (optional). Leave empty to use the demo bypass.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Telegram bot (optional). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Public URL of your deployment.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
