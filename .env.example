# Copy to .env (or set in your hosting provider)

# Required: Postgres connection string.
# Local dev with `docker compose up -d`:
#   postgresql://woyou:woyou@localhost:5444/woyou?schema=public
# Production (Neon free tier — see DEPLOY.md):
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Required in production: 32+ char random string.
SESSION_PASSWORD=change-me-to-a-32+character-random-secret

# One-click role switcher. Set to "false" in real production.
DEMO_MODE=true

# Stripe (optional, nur Startpaket). Leer = Buchung als „Angefragt“.
# Solange DEMO_MODE nicht false ist, werden NUR Test-Schlüssel (sk_test_/rk_test_) benutzt; ein Live-Schlüssel wird ignoriert.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Telegram bot (optional). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Public URL of your deployment.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stripe-Webhook: Endpunkt https://<domain>/api/webhooks/stripe, Event checkout.session.completed (Verlängerung/Abo gibt es nicht mehr)
STRIPE_WEBHOOK_SECRET=

# Mailversand per SMTP (optional). Ohne SMTP_HOST werden Mails nur im Admin protokolliert.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WoYou <service@woyou.de>"
MAIL_TEAM=

# ALT (Weg 1: abgeschaltet, wird ignoriert): persönliche Bewerbungsadressen und Eingang für Firmenantworten
MAIL_ALIAS_DOMAIN=
MAIL_INBOUND_TOKEN=

# Nur lokal mit `next dev`: on = Zahlung für das Startpaket überspringen (nie in Produktion wirksam)
PAYMENT_TEST_MODE=

# KI für Anschreiben (optional, nur mit AV-Vertrag): mistral | anthropic
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Zweite Stellenquelle Adzuna (kostenloses Entwicklerkonto: developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Marketingstrecke ausschalten: off
MARKETING_MAILS=
CRON_SECRET=

# Anbindung EuBiA-CRM (nur mit Datenschutz-Freigabe auf "on" stellen; Einrichtung: bash deploy/crm-einrichten.sh)
EUBIA_CRM_URL=
EUBIA_CRM_TOKEN=
EUBIA_CRM_SYNC=

# Unterlagen-Check im 15-Minuten-Call nach der Zahlung: Buchungsseite bei Terminland (https://www.terminland.de/…).
# Kein Geheimnis. Ohne Wert zeigt woyou.de keinen Kasten, Staging zeigt „Link folgt“. Siehe src/lib/termin.ts
TERMINLAND_URL=

# Selbstcheck vor der Buchung: on = Bestellseite verlangt einen Selbstcheck der letzten 30 Tage. Leer/alles andere = aus (wie bisher).
# Bei Rot entscheidet SELFCHECK_MODE: warn (Standard) = Hinweis plus Häkchen „trotzdem buchen“, block = keine Buchung. Siehe src/lib/selbstcheck-vorbuchung.ts
SELBSTCHECK_VOR_BUCHUNG=
SELFCHECK_MODE=

# Tracking nur mit Einwilligung (Banner mit „Alle akzeptieren“ / „Nur notwendige“, Google Consent Mode v2). Kein Geheimnis.
# Beide leer = wie bisher: nur der Hinweis auf notwendige Cookies, keine externen Skripte, CSP unverändert. Siehe src/lib/tracking-core.ts
# Meta-Pixel-ID (Datensatz-ID aus dem Events Manager), nur Ziffern, z. B. 123456789012345
META_PIXEL_ID=
# Google-Tag-ID: G-XXXXXXX (Analytics) oder AW-XXXXXXXXX (Ads). Andere Werte werden ignoriert.
GOOGLE_TAG_ID=
