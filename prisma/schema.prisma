// WoYou Demo schema — SQLite + Prisma
// Enums are stored as strings; allowed values live in src/lib/enums.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  phone           String?  @unique
  telegramId      String?  @unique
  oauthProvider   String?
  passwordHash    String?
  role            String   // CANDIDATE | COMPANY | ADMIN | SUPER_ADMIN
  locale          String   @default("de")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Soft-delete: when set, the row is hidden from auth/listings and will
  // be hard-deleted by a 30-day purge cron. Restorable by super-admins.
  deletedAt       DateTime?

  candidate       Candidate?
  company         Company?
  marketingOptOut Boolean  @default(false) // Abmeldung von Hinweis-Mails (Link in jeder Mail)
  signupSource    String?  // Herkunft bei Registrierung (utm_source/utm_campaign), für Auswertung je Kanal
  marketingSends  MarketingSend[]
  sentMessages    Message[] @relation("SenderMessages")
  notifications   Notification[]
  assignedTasks   AdminTask[] @relation("AssignedAdmin")
}

model Candidate {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Core identity
  firstName           String?
  lastName            String?
  dateOfBirth         DateTime?
  gender              String?
  nationality         String?
  countryOfResidence  String?
  city                String?

  // Contact channels
  preferredChannel    String    @default("EMAIL") // EMAIL | TELEGRAM | WHATSAPP | PHONE
  telegramHandle      String?
  whatsappNumber      String?
  // Weg 1: eigene E-Mail-Adresse für Bewerbungen (leer = Login-Mail). Nur für Unterlagen und den E-Mail-Entwurf,
  // WoYou verschickt darüber nichts.
  applicationEmail    String?

  // Job preferences
  desiredJobCategory  String?
  desiredJobTitle     String?
  alternativeJobs     String?   // JSON array
  educationLevel      String?
  yearsExperience     Int?
  currentJob          String?
  currentEmployer     String?
  drivingLicense      Boolean?
  willingnessToRelocate Boolean?
  preferredCities     String?   // JSON array
  earliestStart       DateTime?
  expectedSalaryMin   Int?
  expectedSalaryMax   Int?

  // Languages
  germanLevel         String?   // A1 | A2 | B1 | B2 | C1 | C2 | NONE
  englishLevel        String?
  otherLanguages      String?   // JSON array of {lang, level}

  // Language test
  languageTestScore   Int?
  languageTestPassed  Boolean?
  languageTestTakenAt DateTime?

  // About / motivation
  aboutMe             String?
  motivation          String?

  // Family
  familyStatus        String?
  dependents          Int?

  // Demo: document refs (JSON of filenames)
  documents           String?

  // Status & consent
  status              String    @default("REGISTERED") // REGISTERED | INCOMPLETE | COMPLETE | PAID_PLACEABLE | PROPOSED | PLACED
  consentMode         String    @default("PER_COMPANY") // BLANKET | PER_COMPANY
  profileCompleteness Int       @default(10)

  // Stats
  timesViewed         Int       @default(0)
  timesProposed       Int       @default(0)

  // Payment
  paidAt              DateTime?
  stripeSessionId     String?

  placedAt            DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  matches             Match[]
  conversations       Conversation[]
  testAnswers         LanguageTestAnswer[]
  tasks               AdminTask[]
  bookings            ServiceBooking[]
  creditEntries       CreditEntry[]
  creditPurchases     CreditPurchase[]
  subscriptionUntil   DateTime? // ALT (vor Weg 1): Abo „unbegrenzt bewerben“ galt bis hier
  // Weg 1: Bewerbungswerkzeug (Stellensuche, Anschreiben je Stelle, Tracker) ist bis hier freigeschaltet
  toolAccessUntil     DateTime?
  savedJobs           SavedJob[]
}

model LanguageTestAnswer {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  questionId   String
  answer       String
  isCorrect    Boolean
  createdAt    DateTime  @default(now())
}

model Company {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName   String
  industry      String?
  size          String?
  country       String     @default("DE")
  city          String?
  website       String?
  description   String?
  contactName   String?
  contactPhone  String?
  verified      Boolean    @default(false)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  jobRequests   JobRequest[]
  matches       Match[]
  conversations Conversation[]
  tasks         AdminTask[]
}

model JobRequest {
  id                  String   @id @default(cuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobCategory         String   // matches Candidate.desiredJobCategory
  customJobTitle      String?  // when "Sonderjob" requested
  description         String?
  requiredGermanLevel String?
  minYearsExperience  Int?
  salaryMin           Int?
  salaryMax           Int?
  location            String?
  requiredSkills      String?  // JSON
  status              String   @default("OPEN") // OPEN | PAUSED | FILLED

  isCustomRequest     Boolean  @default(false) // true if jobCategory not in catalog -> goes to admin

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  matches             Match[]
}

model Match {
  id                    String   @id @default(cuid())
  candidateId           String
  candidate             Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobRequestId          String?
  jobRequest            JobRequest? @relation(fields: [jobRequestId], references: [id])

  matchScore            Int?
  status                String   @default("DRAFT")
  // DRAFT | AWAITING_CANDIDATE_CONSENT | CANDIDATE_APPROVED | CANDIDATE_DECLINED |
  // SHARED_WITH_COMPANY | COMPANY_INTERESTED | COMPANY_DECLINED | IN_CONVERSATION | HIRED

  companyFeedback       String?
  companyFeedbackRating Int?

  candidateRespondedAt  DateTime?
  companyRespondedAt    DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  conversation          Conversation?
  tasks                 AdminTask[]
}

model Conversation {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  matchId      String?   @unique
  match        Match?    @relation(fields: [matchId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages     Message[]
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User         @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  channel         String       @default("PLATFORM") // PLATFORM | EMAIL | TELEGRAM | WHATSAPP
  body            String
  // Optional file attachment. Stored on the woyou_uploads volume under
  // chats/<conversationId>/<filename>. We keep the original name for display.
  attachmentFilename     String?
  attachmentOriginalName String?
  attachmentMime         String?
  attachmentSize         Int?
  createdAt       DateTime     @default(now())
  readAt          DateTime?
}

model AdminTask {
  id            String   @id @default(cuid())
  candidateId   String?
  candidate     Candidate? @relation(fields: [candidateId], references: [id])
  companyId     String?
  company       Company?   @relation(fields: [companyId], references: [id])
  matchId       String?
  match         Match?     @relation(fields: [matchId], references: [id])

  kind          String   // VISA | DOCUMENT_CHECK | VERIFICATION | CONTACT | OTHER
  title         String
  description   String?
  status        String   @default("OPEN") // OPEN | IN_PROGRESS | DONE
  dueDate       DateTime?
  assignedToId  String?
  assignedTo    User?    @relation("AssignedAdmin", fields: [assignedToId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model JobCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameDe    String
  nameEn    String
  nameFr    String
  nameAr    String
  group     String   // care, hospitality, construction, it, logistics, other
  active    Boolean  @default(true)
}

// Captured server-side errors. Light-weight Sentry replacement so admins
// can spot patterns without an external service.
model ErrorLog {
  id        String   @id @default(cuid())
  digest    String?
  level     String   // ERROR | WARN
  message   String
  stack     String?
  path      String?
  method    String?
  status    Int?
  userId    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([digest])
}

model AuditLog {
  id          String   @id @default(cuid())
  // The actor; null for cron / system actions.
  actorId     String?
  actorEmail  String?
  actorRole   String?

  action      String   // e.g. CANDIDATE_STATUS_CHANGE, MATCH_PROPOSE, …
  // Optional foreign-key-ish references (no FK so we don't break audit on delete).
  candidateId String?
  companyId   String?
  matchId     String?
  taskId      String?

  // Free-form details: { from: …, to: …, note: … }
  meta        String?  // JSON

  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([candidateId, createdAt])
  @@index([companyId, createdAt])
  @@index([action, createdAt])
}

// Buchung eines Zusatz-Services (z. B. Bewerbungs-Service 25 Bewerbungen).
// Ablauf: REQUESTED (ohne Stripe) bzw. PENDING_PAYMENT → PAID → IN_PROGRESS → DONE | CANCELLED
model ServiceBooking {
  id               String    @id @default(cuid())
  candidateId      String
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  packageKey       String    // siehe src/lib/services.ts
  amountCents      Int
  currency         String    @default("eur")
  status           String    @default("REQUESTED")
  contactPhone     String?
  targetJobs       String?
  targetRegions    String?
  notes            String?
  acceptedTermsAt  DateTime
  waiverAcceptedAt DateTime? // Zustimmung zum vorzeitigen Leistungsbeginn (Widerrufsrecht)
  stripeSessionId  String?   @unique
  paidAt           DateTime?
  applicationsSent Int       @default(0)
  applicationsGoal Int       @default(25)
  adminNote        String?
  consentSendAt    DateTime? // ALT (vor Weg 1): Vollmacht, Bewerbungen im Namen des Kunden zu versenden
  aliasLocal       String?   @unique // ALT (vor Weg 1): z. B. "fatima.benali" → fatima.benali@<MAIL_ALIAS_DOMAIN>
  toolMonths       Int       @default(0) // Weg 1: Monate Bewerbungswerkzeug, die mit diesem Paket gebucht wurden
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profile          ApplicationProfile?
  leads            JobLead[]

  @@index([status, createdAt])
  @@index([candidateId])
}

// Bewerbungsmappe: alle Angaben für Lebenslauf und Anschreiben (Abschnitte als JSON)
model ApplicationProfile {
  id           String         @id @default(cuid())
  bookingId    String         @unique
  booking      ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  data         String         // JSON, siehe src/lib/application.ts
  dataEn       String?        // englische Fassung (vom Bearbeiter gepflegt, nur bei Bedarf)
  photoFile    String?        // Dateiname im Kandidaten-Upload-Ordner
  ownCvFile    String?        // eigener, hochgeladener Lebenslauf (PDF) im Kandidaten-Upload-Ordner
  useOwnCv     Boolean        @default(false) // beim Versand eigenen statt erzeugten Lebenslauf anhängen
  baseLetter   String?        // Grund-Anschreiben (Bearbeiter passt je Stelle an)
  status       String         @default("DRAFT") // DRAFT | SUBMITTED | APPROVED
  submittedAt  DateTime?
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ALT (vor Weg 1, nicht mehr genutzt): Stelle, die das Team für eine Buchung ausgewählt und verschickt hat
model JobLead {
  id            String         @id @default(cuid())
  bookingId     String
  booking       ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  source        String         @default("BA") // BA | MANUAL
  sourceRef     String?        // Referenznummer der Quelle
  title         String
  company       String
  city          String?
  url           String?        // Link zur Ausschreibung
  applyUrl      String?        // externer Bewerbungslink der Firma
  email         String?        // Bewerbungs-E-Mail (vom Bearbeiter geprüft)
  contactName   String?
  description   String?
  coverLetter   String?
  lang          String         @default("de") // de | en: Sprache von Anschreiben und Lebenslauf
  status        String         @default("SELECTED") // SUGGESTED | HIDDEN | SELECTED | READY | SENT | APPLIED_MANUALLY | DISCARDED
  score         Int?           // Passung 0–100 (Regeln, ggf. mit KI gemittelt)
  matchNotes    String?        // JSON: kurze Gründe für/gegen die Stelle
  aiNote        String?        // Einschätzung der KI in einem Satz
  meta          String?        // JSON: Entfernung, Arbeitszeit, Gehalt, Aufgaben/Anforderungen (Auszug)
  sentAt        DateTime?
  response      String?        // Rückmeldung der Firma (Notiz / eingehende Mail)
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([bookingId, source, sourceRef])
  @@index([bookingId, status])
}

// Protokoll aller ausgehenden Mails – auch wenn (noch) kein SMTP konfiguriert ist.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String   // SENT | SKIPPED | FAILED
  error     String?
  bookingId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ALT (vor Weg 1, nicht mehr genutzt): Guthaben an Bewerbungen: +25 je Paket, -1 je verschickter Bewerbung. Mit aktivem Abo wird nichts abgezogen (Eintrag mit 0).
model CreditEntry {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  delta       Int
  reason      String    // START | PACK | GRANT | APPLICATION | REFUND
  note        String?
  bookingId   String?
  leadId      String?   @unique // je Bewerbung höchstens einmal abgebucht
  purchaseId  String?
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

// Käufe nach dem Startpaket. Weg 1: Verlängerung des Werkzeugs (TOOL_MONTH) oder Monatsabo (TOOL_SUBSCRIPTION).
// ALT (vor Weg 1): Nachkauf 25 Bewerbungen (PACK_25) oder Abo „unbegrenzt bewerben“ (SUBSCRIPTION).
model CreditPurchase {
  id                   String    @id @default(cuid())
  candidateId          String
  candidate            Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind                 String    // TOOL_MONTH | TOOL_SUBSCRIPTION (alt: PACK_25 | SUBSCRIPTION)
  months               Int?      // Weg 1: so viele Monate Werkzeug schaltet der Kauf frei
  amountCents          Int
  status               String    @default("REQUESTED") // REQUESTED | PENDING_PAYMENT | PAID | ACTIVE | CANCELLING | ENDED | CANCELLED
  stripeSessionId      String?
  stripeSubscriptionId String?   @unique
  paidAt               DateTime?
  periodEnd            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([candidateId])
}

// Automatische Hinweis-Mails (Marketingstrecke): je Person und Schritt höchstens einmal
model MarketingSend {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  step   String
  sentAt DateTime @default(now())

  @@unique([userId, step])
}

// Karriereseiten einzelner Arbeitgeber mit öffentlichem Stellen-Feed (Personio, Greenhouse, Lever).
// Das Team hinterlegt Wunscharbeitgeber nach und nach; die Stellen fließen in die automatischen Vorschläge.
model CareerFeed {
  id        String   @id @default(cuid())
  name      String
  kind      String   // PERSONIO | GREENHOUSE | LEVER
  slug      String   // Kennung im Feed, z. B. "pflegedienst-xy" aus pflegedienst-xy.jobs.personio.de
  active    Boolean  @default(true)
  lastCount Int?
  lastError String?
  checkedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([kind, slug])
}

// Weg 1: Bewerbungs-Tracker. Stellen, die sich die Kundin bzw. der Kunde in der Stellensuche selbst gemerkt hat,
// mit eigenem Stand (gemerkt, beworben, Antwort, Gespräch, Absage, Zusage) und Notizen. Nur die Person selbst
// pflegt diese Liste; das Team wählt hier nichts aus und sieht sie nicht.
model SavedJob {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  source      String    // BA | ARBEITNOW | ADZUNA | KARRIERESEITE | MANUAL
  sourceRef   String?
  title       String
  company     String
  city        String?
  url         String?   // Link zur Anzeige
  applyUrl    String?   // Bewerbungsseite des Arbeitgebers
  email       String?   // Bewerbungs-E-Mail aus der Anzeige (die Person schreibt selbst aus ihrem Postfach)
  contactName String?
  description String?
  meta        String?   // JSON: Arbeitszeit, Entfernung, gefordertes Deutsch, Veröffentlichung
  status      String    @default("SAVED") // SAVED | APPLIED | REPLY | INTERVIEW | REJECTED | OFFER
  appliedAt   DateTime?
  repliedAt   DateTime?
  interviewAt DateTime?
  closedAt    DateTime?
  notes       String?
  coverLetter String?
  letterLang  String    @default("de")
  // Entwurf der E-Mail, die die Person selbst aus dem eigenen Postfach schickt (leer = Vorschlag)
  mailTo      String?
  mailSubject String?
  mailBody    String?
  followUpAt  DateTime? // eigene Erinnerung zum Nachfassen
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([candidateId, source, sourceRef])
  @@index([candidateId, status])
}

// Selbstcheck-Statistik (Pilot Westbalkan, 26.10.2026): nur das Ergebnis, ohne Bezug zur Person.
// Keine Nutzer-ID, keine IP, kein Freitext (Beruf und Land als Text bleiben im Browser).
// createdAt wird auf die volle Stunde gerundet, damit sich Einträge nicht mit Server-Logs verknüpfen lassen.
model SelfCheckResult {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  country   String   // RS | BA | ME | XK | MK | AL | other
  balkan    Boolean
  gruppe    String?  // ce | c | bus | lager | stapler | dispo | andere (nur Westbalkan)
  german    String?  // none | A1 | A2 | B1 | B2 | C1
  level     String   // green | yellow | red
  locale    String?
  source    String?  // utm_source aus dem Werbelink, falls vorhanden

  @@index([createdAt])
}

// Verbraucherrecht (26.10.2026): Widerruf über „Vertrag widerrufen“ (auch per Brief/E-Mail vom Team erfasst)
// und Kündigung über „Verträge hier kündigen“. Ohne Anmeldung möglich, deshalb nur lose mit der Buchung verknüpft.
model Widerruf {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now()) // Zeitpunkt des Eingangs
  name           String
  email          String    // E-Mail für die Bestätigung
  bookingRef     String    // Buchungsnummer oder E-Mail der Buchung, wie eingegeben
  bookingId      String?   // zugeordnete Buchung (ServiceBooking.id), wenn gefunden
  message        String?
  status         String    @default("OFFEN") // OFFEN | ERSTATTET | ERLEDIGT
  refundCents    Int?
  refundedAt     DateTime?
  stripeRefundId String?
  adminNote      String?
  updatedAt      DateTime  @updatedAt

  @@index([createdAt])
  @@index([bookingId])
}

model Kuendigung {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now()) // Zeitpunkt des Eingangs
  art               String    // ordentlich | ausserordentlich
  grund             String?
  name              String
  email             String    // E-Mail der Buchung
  bookingRef        String?
  bookingId         String?
  vertrag           String
  wirksam           String    // naechstmoeglich | datum
  wirksamZu         DateTime? // gewünschtes Datum
  bestaetigungEmail String
  vertragsende      DateTime? // festes Ende des Werkzeugs bzw. gewünschtes Datum
  status            String    @default("OFFEN") // OFFEN | ERLEDIGT
  adminNote         String?
  updatedAt         DateTime  @updatedAt

  @@index([createdAt])
}
